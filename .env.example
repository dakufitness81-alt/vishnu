# ── AI (OPTIONAL — the agent works 100% offline without these) ─────────────
# LLM writing (ideas + scripts) and voice narration:
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# ── X (Twitter) ─────────────────────────────────────────────────────────────
# 1) https://developer.x.com → create app (OAuth redirect: http://localhost:8080/callback)
# 2) fill the two lines below
# 3) python -m agent auth x        (tokens land in secrets/x_tokens.json)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8080/callback
# Or skip the flow and paste an OAuth2 user token directly:
# X_API_TOKEN=

# ── YouTube ─────────────────────────────────────────────────────────────────
# 1) Google Cloud Console → enable YouTube Data API v3 → OAuth client (Desktop)
# 2) download the client_secret JSON and set its path here:
# YOUTUBE_CLIENT_SECRET_JSON=/home/user/vishnu/secrets/client_secret.json
# 3) python -m agent auth youtube
# YOUTUBE_PRIVACY=public       # or unlisted / private

# ── TikTok (Content Posting API — approved developer app required) ─────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Facebook Page ───────────────────────────────────────────────────────────
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ── Instagram (business account linked to the FB page) ─────────────────────
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
